// Phase 12: packages declared in imported modules are initialized.
//
// counter_pkg.mypl declares package-level state (counter = 41). Run with:
//   ./bin/mypl examples/phases/phase12_import_packages.mypl
// Expected output: 41 then 42 — the initializer runs before main() exactly
// as if the package were declared in the main file.
import "../modules/phase12_counter_pkg.mypl";

proc main() -> int {
    print int_to_string(counter.get());
    counter.bump();
    print int_to_string(counter.get());
    return 0;
}
